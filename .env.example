# Gmail SMTP — used when someone submits the contact form
# 1. Use a Google account with 2-Step Verification enabled
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy this file to .env.local and fill in the values below

# Gmail address that sends the notification (your Google account)
GMAIL_USER=your.name@gmail.com

# 16-character Google App Password (not your normal Gmail password)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that receives contact form submissions (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=your.name@gmail.com
