# Gmail SMTP — used when someone submits the contact form
# 1. Sign in to zyvrontech@gmail.com with 2-Step Verification enabled
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy this file to .env.local and fill in the App Password below

# Gmail account that sends contact notifications
GMAIL_USER=zyvrontech@gmail.com

# 16-character Google App Password (not your normal Gmail password)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=zyvrontech@gmail.com
